; em.mdp - Single point energy evaluation
integrator  = md
dt          = 0.001
nsteps      = 0

nstlist     = 1
cutoff-scheme = Verlet

coulombtype = PME
rcoulomb    = 1.0

vdwtype     = Cut-off
rvdw        = 1.0

constraints = none

nstenergy   = 1

; No thermostat/barostat for single point
tcoupl      = no
pcoupl      = no
